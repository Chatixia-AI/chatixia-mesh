# ─── Registry Server ──────────────────────────────────────────────────────
# JWT signing secret. Unset/empty → random per run. Generate: openssl rand -hex 32
SIGNALING_SECRET=change-me-to-a-random-string
API_KEYS_FILE=api_keys.json

# Admin token for pairing approval and hub writes (sent as x-admin-token).
# Unset/empty → a random token is generated at startup and logged once.
# Generate: openssl rand -hex 32
# REGISTRY_ADMIN_TOKEN=

# Browser origins allowed to call the registry cross-origin (comma-separated).
# Default: http://localhost:8080,http://127.0.0.1:8080,http://localhost:5174,http://127.0.0.1:5174
# Empty = none. The bundled hub is same-origin and needs no entry.
# REGISTRY_ALLOWED_ORIGINS=

# Eviction windows in seconds (defaults shown)
# REGISTRY_TASK_RETENTION_SECS=3600
# REGISTRY_AGENT_EVICTION_SECS=3600
# REGISTRY_ONBOARDING_RETENTION_SECS=86400

# Optional: TURN relay for NAT traversal
# TURN_URL=turn:your-server:3478
# TURN_SECRET=your-coturn-secret

# ─── Sidecar ─────────────────────────────────────────────────────────────
API_KEY=ak_dev_001
SIGNALING_URL=ws://localhost:8080/ws
TOKEN_URL=http://localhost:8080/api/token
IPC_SOCKET=/tmp/chatixia-sidecar.sock
# Set to 1 when the sidecar is managed externally (e.g. docker-compose service):
# the agent connects to IPC_SOCKET without spawning or unlinking it.
# CHATIXIA_SIDECAR_EXTERNAL=0

# ─── Python Agent ────────────────────────────────────────────────────────
CHATIXIA_REGISTRY_URL=http://localhost:8080
CHATIXIA_AGENT_ID=my-agent

# LLM Provider (azure or ollama)
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# Ollama (if LLM_PROVIDER=ollama)
# OLLAMA_URL=http://localhost:11434/v1
# AGENT_MODEL=qwen3:4b

# Logging
RUST_LOG=info
LOG_LEVEL=WARNING
